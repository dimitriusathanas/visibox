# Copy to .env.local and fill in from your Supabase project (Settings → API).
# Both values are public by design: the anon key only works through
# row-level security. The AI keys are NOT set here; they live in the
# Supabase function secrets (see README).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
