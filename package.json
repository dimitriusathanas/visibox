{
  "name": "virtual-fridge",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.117.2",
    "expo": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-crypto": "~58.0.7",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-localization": "~58.0.5",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "playwright-core": "1.64.1",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web --output-dir dist",
    "build:preview": "EXPO_PUBLIC_PREVIEW=1 expo export --platform web --output-dir dist",
    "e2e": "node e2e/smoke.mjs && node e2e/flows.mjs && node e2e/polish.mjs",
    "sync:shared": "node scripts/sync-shared.mjs",
    "data:foodkeeper": "node scripts/build-foodkeeper.mjs && node scripts/sync-shared.mjs",
    "lint": "expo lint",
    "package:preview": "node scripts/package-preview.mjs dist/preview.html && node e2e/preview-check.mjs dist/preview.html dist/preview.png"
  },
  "private": true
}
